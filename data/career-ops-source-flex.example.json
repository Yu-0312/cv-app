{
  "name": "Career Ops Source Flex Rules",
  "description": "Expansion rules that make source collection more flexible than a fixed company list. These rules generate extra source candidates and search queries from markets, role aliases, ATS domains, job boards, seed sources, and company career URL patterns.",
  "titleFilter": {
    "positive": ["backend engineer", "full stack engineer", "ai engineer", "product manager"]
  },
  "markets": [
    {
      "code": "tw",
      "locations": ["Taiwan", "Taipei", "Hsinchu", "Taichung", "Kaohsiung", "台灣", "台北", "新竹"],
      "jobBoards": [
        "https://www.104.com.tw/jobs/search/",
        "https://www.1111.com.tw/search/job",
        "https://www.yourator.co/companies",
        "https://www.cakeresume.com/jobs"
      ]
    },
    {
      "code": "cn",
      "locations": ["China", "Shanghai", "Beijing", "Shenzhen", "Hangzhou", "中國", "上海", "北京", "深圳", "杭州"],
      "jobBoards": [
        "https://www.zhipin.com/",
        "https://www.lagou.com/",
        "https://www.liepin.com/",
        "https://www.kanzhun.com/"
      ]
    },
    {
      "code": "us",
      "locations": ["United States", "San Francisco", "Seattle", "New York", "Remote US"],
      "titleFilter": {
        "locationPositive": ["United States", "US", "San Francisco", "Seattle", "New York", "Remote US", "Remote (US)", "US-Remote"]
      },
      "jobBoards": [
        "https://www.workatastartup.com/jobs",
        "https://wellfound.com/jobs"
      ]
    },
    {
      "code": "uk",
      "locations": ["United Kingdom", "London", "Cambridge", "Remote UK"],
      "titleFilter": {
        "locationPositive": ["United Kingdom", "UK", "London", "Cambridge", "Remote UK", "Remote (UK)"]
      },
      "jobBoards": [
        "https://wellfound.com/jobs",
        "https://otta.com/jobs"
      ]
    }
  ],
  "roleAliases": [
    {
      "canonical": "Frontend Engineer",
      "aliases": ["frontend engineer", "front-end engineer", "web engineer", "react engineer", "前端工程師", "網頁工程師"]
    },
    {
      "canonical": "Product Engineer",
      "aliases": ["product engineer", "full stack product engineer", "產品工程師", "全端產品工程師"]
    },
    {
      "canonical": "Data Analyst",
      "aliases": ["data analyst", "business analyst", "analytics engineer", "資料分析師", "數據分析師"]
    }
  ],
  "atsDomains": [
    "boards.greenhouse.io",
    "jobs.lever.co",
    "jobs.ashbyhq.com",
    "apply.workable.com",
    "jobs.smartrecruiters.com",
    "myworkdayjobs.com"
  ],
  "sourceSeeds": [
    {
      "name": "Example Greenhouse Global Board",
      "enabled": false,
      "adapter": "greenhouse",
      "url": "https://boards.greenhouse.io/example",
      "markets": ["us", "uk"],
      "maxDiscovered": 100,
      "tags": ["ats", "greenhouse"]
    },
    {
      "name": "Example Workday Country Search",
      "enabled": false,
      "adapter": "workday",
      "url": "https://example.wd1.myworkdayjobs.com/External",
      "site": "External",
      "searchText": "{location}",
      "markets": ["tw", "us"],
      "maxDiscovered": 100,
      "detailLimit": 20,
      "tags": ["ats", "workday"]
    }
  ],
  "careerPathPatterns": [
    "/careers",
    "/career",
    "/jobs",
    "/join-us",
    "/recruiting",
    "/talent"
  ],
  "companyDomains": [
    {
      "name": "Example Company",
      "enabled": false,
      "market": "global",
      "domain": "example.com",
      "industry": "software"
    }
  ]
}
